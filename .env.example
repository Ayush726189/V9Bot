# Create a bot token at https://discord.com/developers/applications
DISCORD_TOKEN=replace_with_your_bot_token

# Comma-separated immutable owners
OWNER_IDS=1159164727323271320,1103109628591620106

# Discord roles
OWNER_ROLE_ID=1426555185454649447
USER_ROLE_ID=1536277694927474720

# Default container plan (all values can be changed here before bot startup)
DEFAULT_MEMORY_GB=8
DEFAULT_CPU_CORES=4
DEFAULT_DISK_GB=60
# Owner-only /create_vps upper limits (custom plans cannot be below the defaults)
MAX_CUSTOM_MEMORY_GB=256
MAX_CUSTOM_CPU_CORES=64
MAX_CUSTOM_DISK_GB=2000
MAX_VPS_PER_USER=1
DEFAULT_OS_IMAGE=ubuntu:22.04
DOCKER_NETWORK=bridge
MAX_CONTAINERS=250
